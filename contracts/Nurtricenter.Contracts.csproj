<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project holds what belongs to THIS microservice and nothing else: the integration
    contracts it publishes to RabbitMQ and the exchange registry those contracts are routed by.

    Why it is separate from src/: the contracts are the service's public surface, consumed by
    other microservices (and their tests) without dragging in the service's internals. The
    Application layer maps domain events onto these records; the WorkerService publishes them.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nurtricenter.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      IntegrationMessage is the vendor base record every cross-service message extends. It has no
      transport logic, so declaring it here does not drag a broker into a project that only
      declares contracts.
    -->
    <PackageReference Include="Joseco.Communication.External.Contracts" Version="1.0.1" />
  </ItemGroup>

</Project>
